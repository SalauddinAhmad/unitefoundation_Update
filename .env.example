# ============================================
# Unite Foundation — Frontend Environment Vars
# Copy this file to `.env` and fill in real values.
# ============================================

# Backend REST API base URL (Express + MySQL)
VITE_API_BASE_URL=https://api.unitefoundation.bd

# Public site URL (used for canonical links, share URLs, emails)
VITE_SITE_URL=https://unitefoundation.bd

# Auth — JWT Bearer token is read from localStorage key below
VITE_AUTH_STORAGE_KEY=uf_auth_token
