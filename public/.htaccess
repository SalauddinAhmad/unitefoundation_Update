# Disable directory listing (block /assets/, /qr/, etc.)
Options -Indexes

# Block access to hidden/sensitive files
<FilesMatch "^\.(?!well-known)|\.(env|env\..*|log|sql|md|yml|yaml|lock|sh|bak|old|ini|conf)$">
  Require all denied
</FilesMatch>

# React SPA — send all routes to index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Allow larger uploads (base64 images can be 2-5 MB)
<IfModule mod_php.c>
  php_value upload_max_filesize 32M
  php_value post_max_size 32M
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 32M
  php_value post_max_size 32M
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 32M
  php_value post_max_size 32M
</IfModule>
# LiteSpeed / cPanel body size
<IfModule LiteSpeed>
  SecRequestBodyLimit 33554432
</IfModule>

# Cache static assets (Vite hashes filenames — safe to cache long)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# NEVER cache index.html — always serve latest so new JS bundle loads immediately
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
