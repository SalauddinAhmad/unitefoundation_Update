# ================================================================
# Unite Foundation Backend — Environment Variables
# Copy to `.env` on server (cPanel → Node.js App → Env Variables)
# NEVER commit real values.
# ================================================================

# --- Runtime ---
NODE_ENV=production
PORT=3000

# --- Database (cPanel MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=unitefdn_main
DB_USER=unitefdn_admin
DB_PASSWORD=REPLACE_ME

# --- JWT (auto-generate a 64+ char random string) ---
JWT_SECRET=REPLACE_ME_LONG_RANDOM_STRING
JWT_EXPIRES_IN=24h

# --- CORS (comma separated origins) ---
CORS_ORIGINS=https://unitefoundation.bd,https://www.unitefoundation.bd,http://localhost:8080

# --- SMTP (cPanel email) ---
SMTP_HOST=mail.unitefoundation.bd
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@unitefoundation.bd
SMTP_PASS=REPLACE_ME
SMTP_FROM="Unite Foundation <no-reply@unitefoundation.bd>"

# If the host blocks outbound SMTP ports, automatically use cPanel's local
# Exim/sendmail delivery. Set false only when local sendmail is unavailable.
SMTP_SENDMAIL_FALLBACK=true
SENDMAIL_PATH=/usr/sbin/sendmail

# --- Frontend URL (for password reset links) ---
FRONTEND_URL=https://unitefoundation.bd

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
